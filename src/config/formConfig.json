    "label": "Username",
    "required": true,
    "minLength": 3
  },
  {
    "name": "email",
    "type": "email",
    "label": "Email",
    "required": true,
    "validate": "email"
  },
  {
    "name": "password",
    "type": "password",
    "label": "Password",
    "required": true,
    "minLength": 6
  },
  {
