  {
    "name": "address",
    "type": "textarea",
    "label": "Address",
    "required": true
  },
  {
    "name": "website",
    "type": "url",
    "label": "Website",
    "validate": "url"
  },
  {
    "name": "profilePicture",
    "type": "file",
    "label": "Upload Profile Picture"
  },
  {
    "name": "color",
    "type": "color",
    "label": "Favorite Color"
  },
  {
    "name": "agreeTerms",
    "type": "checkbox",
    "label": "I agree to the Terms and Conditions",
    "required": true
  }
