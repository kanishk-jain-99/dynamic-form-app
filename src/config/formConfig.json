  },
  {
    "name": "dob",
    "type": "date",
    "label": "Date of Birth",
    "required": true
  },
  {
    "name": "age",
    "type": "number",
    "label": "Age",
    "required": true,
    "min": 18,
    "max": 100
  },
  {
    "name": "gender",
    "type": "radio",
    "label": "Gender",
    "options": ["Male", "Female", "Other"],
    "required": true
  },
  {
    "name": "subscribe",
    "type": "checkbox",
    "label": "Subscribe to Newsletter"
  },
  {
